{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Source",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "authority",
    "purpose",
    "site_url",
    "api_url",
    "api_method",
    "format",
    "authentication",
    "freshness",
    "priority",
    "description",
    "retrieval_hint",
    "enabled"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "site_url": {
      "type": "string",
      "format": "uri"
    },
    "api_url": {
      "type": "string",
      "format": "uri"
    },
    "batch_api_url": {
      "type": "string",
      "format": "uri"
    },
    "api_method": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "authentication": {
      "type": "string"
    },
    "freshness": {
      "type": "string"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "retrieval_hint": {
      "type": "string",
      "minLength": 1
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
