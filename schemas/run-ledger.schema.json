{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Run Ledger",
  "type": "object",
  "required": [
    "run_id",
    "started_at",
    "project",
    "sources",
    "references_loaded",
    "checks",
    "findings_created",
    "findings_verified",
    "limitations"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "project": {
      "type": "string"
    },
    "framework_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "references_loaded": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings_created": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings_verified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
