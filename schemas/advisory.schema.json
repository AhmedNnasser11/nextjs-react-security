{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Advisory",
  "type": "object",
  "required": [
    "advisory_id",
    "source",
    "canonical_id",
    "package",
    "ecosystem",
    "affected_versions",
    "patched_versions",
    "severity",
    "confidence"
  ],
  "properties": {
    "advisory_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "canonical_id": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "ecosystem": {
      "type": "string"
    },
    "installed_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "affected_versions": {
      "type": "string"
    },
    "patched_versions": {
      "type": [
        "string",
        "null"
      ]
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "cwe": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cve": {
      "type": [
        "string",
        "null"
      ]
    },
    "ghsa": {
      "type": [
        "string",
        "null"
      ]
    },
    "osv": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "exploit_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "withdrawn": {
      "type": "boolean"
    },
    "malware": {
      "type": "boolean"
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string"
    }
  }
}
